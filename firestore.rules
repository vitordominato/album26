rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // Catálogo público (read-only): seleções, jogadores, figurinhas
    match /teams/{teamId} {
      allow read: if true;
      allow write: if false; // só via Admin SDK (seed)

      match /players/{playerId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /stickers/{stickerId} {
      allow read: if true;
      allow write: if false;
    }

    // Usuários
    match /users/{userId} {
      // Perfil é legível por qualquer autenticado (precisa pra mostrar nomes nos grupos)
      allow read: if isSignedIn();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt']);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Coleção: leitura aberta pra autenticados (necessário pro matching client-side
      // entre membros do mesmo grupo no plano Spark, sem Cloud Functions). Só o dono escreve.
      match /collection/{stickerId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(userId)
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 0;
        allow delete: if isOwner(userId);
      }
    }

    // Grupos: qualquer autenticado pode ler (necessário para entrar via código de convite);
    // só membros conseguem atualizar; só o criador deleta.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.inviteCode == resource.data.inviteCode
        && (
          isGroupMember(groupId)
          // Entrar via código: não-membro pode se adicionar à memberIds
          // (e só isso) — sem essa cláusula, ninguém consegue entrar.
          || (
            !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          )
        );
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      match /members/{userId} {
        allow read: if isGroupMember(groupId);
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId)
          || get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid;
      }

      // Placares dos jogos da Copa: qualquer membro do grupo lê e escreve.
      match /matches/{matchNum} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && request.resource.data.homeScore is int
          && request.resource.data.awayScore is int
          && request.resource.data.homeScore >= 0
          && request.resource.data.awayScore >= 0
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isGroupMember(groupId);
      }

      // Palpites do bolão: cada membro lê/escreve só os próprios.
      // Doc id = `${uid}_${matchNum}`. Membros do grupo veem todos pra calcular ranking.
      match /picks/{pickId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.matchNum is int
          && request.resource.data.matchNum >= 1
          && request.resource.data.matchNum <= 104
          && request.resource.data.homeScore is int
          && request.resource.data.awayScore is int
          && request.resource.data.homeScore >= 0
          && request.resource.data.awayScore >= 0;
        allow delete: if isSignedIn()
          && resource.data.uid == request.auth.uid;
      }
    }

    // Trocas: leitura/escrita só pelas duas partes envolvidas
    match /trades/{tradeId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUserId
        && request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.fromUserId ||
        request.auth.uid == resource.data.toUserId
      );
      allow delete: if isSignedIn() && request.auth.uid == resource.data.fromUserId;
    }

    // Notificações in-app: só o dono lê/escreve
    match /notifications/{userId}/items/{notifId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Ativos do álbum (figurinhas, escudos, fotos das seleções) — leitura pública,
    // upload só via Admin SDK no seed
    match /stickers/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /teams/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /players/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Avatars dos usuários — só o dono escreve
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
